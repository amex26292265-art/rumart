// Rumart — reseller marketplace data model.
// SQLite for local dev; swap `provider` to "postgresql" and DATABASE_URL for Vercel.
// SQLite has no native enums, so status/type fields are strings with documented values.

generator client {
  // driverAdapters + queryCompiler = an engine-less client (WASM query
  // compiler, no native Rust engine, no filesystem). It connects DIRECTLY to
  // Neon over the @neondatabase/serverless driver, so it runs on Cloudflare
  // Workers without Prisma's hosted platform.
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "queryCompiler"]
}

datasource db {
  // DATABASE_URL is the direct Neon Postgres URL, used both by the app at
  // runtime (through the Neon driver adapter) and by the Prisma CLI.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth / customers ──────────────────────────────────────────────────────
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  username      String?  @unique
  bio           String?
  avatarUrl     String?
  bannerUrl     String?
  discord       String?
  telegram      String?
  website       String?
  country       String?
  role          String   @default("customer") // customer | admin | seller
  walletBalance Float    @default(0) // store credit, in site currency
  twoFactorSecret String? // reserved for 2FA (TOTP)
  twoFactorEnabled Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders        Order[]
  reviews       Review[]
  wishlist      WishlistItem[]
  notifications Notification[]
  auditLogs     AuditLog[]
  deposits      Deposit[]
  sellerProfile SellerProfile?
  sellerApplications SellerApplication[]
  forumTopics   ForumTopic[]
  forumPosts    ForumPost[]
  forumReactions ForumReaction[]
  following     Follow[] @relation("Following")
  followers     Follow[] @relation("Followers")
  conversationParts ConversationParticipant[]
  messagesSent  Message[]
  activities    ActivityEvent[]
}

// Wallet top-up via a crypto payment gateway (Cryptomus). Credited to
// User.walletBalance once the gateway confirms the payment on-chain (webhook).
model Deposit {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Float // requested top-up amount, in price currency (price_amount)
  currency   String   @default("USD") // price_currency
  provider   String   @default("nowpayments")
  providerId String? // gateway invoice id (NOWPayments invoice_id)
  status     String   @default("pending") // pending | paid | partial | failed | cancelled
  credited   Boolean  @default(false) // guards against double-crediting

  // NOWPayments payment details (populated from the IPN callback).
  paymentId    String? // NOWPayments payment_id
  payStatus    String? // raw NOWPayments payment_status
  payCurrency  String? // coin actually used (e.g. usdttrc20, btc)
  payAmount    Float? // expected amount in the pay currency
  actuallyPaid Float? // amount actually received
  payAddress   String? // deposit address shown to the customer
  txHash       String? // on-chain payin hash

  // Optional: buy this product automatically once the payment confirms
  // (seamless buy → pay → deliver). Null for a plain wallet top-up.
  productId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
}

// ─── Supplier abstraction ──────────────────────────────────────────────────
// Never hardcode a single supplier. Each product references its supplier.
model Supplier {
  id        String    @id @default(cuid())
  slug      String    @unique // lzt | manual | ...
  name      String
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]
  syncRuns  SyncRun[]
}

// ─── Catalog ───────────────────────────────────────────────────────────────
model Category {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String?
  icon             String? // lucide icon name or asset path
  /** Optional public URL/path for category tile logo (SVG/PNG). */
  logoUrl          String?
  /** Optional wide banner image for category header. */
  bannerUrl        String?
  accent           String   @default("#2563eb")
  order            Int      @default(0)
  featured         Boolean  @default(false)
  // Maps this storefront category to a supplier-side category (e.g. LZT "steam").
  supplierCategory String?
  createdAt        DateTime @default(now())

  products    Product[]
  syncRules   SyncRule[]
  pricingRules PricingRule[]
}

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  description    String?
  // Money is stored in the smallest sensible unit as Float; site currency in Setting.
  price          Float // customer-facing sell price (after pricing engine)
  cost           Float // supplier price we paid / would pay
  currency       String   @default("USD")
  status         String   @default("active") // active | hidden | sold | unavailable
  deliveryType   String   @default("auto") // auto | manual
  stock          Int      @default(1)
  images         Json? // string[]
  attributes     Json? // full parsed supplier info (stats, games, sections…)
  supplierItemId String? // id on the supplier side (e.g. LZT item id)
  // lzt = synced reseller stock | manual = admin-created | seller = marketplace seller
  sourceType     String   @default("lzt")
  // Encrypted JSON array of credential payloads for manual/seller stock.
  credentialStock String?
  sellerId       String?
  seller         SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  // Denormalized, indexable fields for fast server-side filtering.
  country      String? // normalized account country name
  emailNative  Boolean @default(false) // native email access included
  vac          Boolean @default(false) // has a VAC / game ban
  level        Int? // account/profile level (category dependent)
  tags         Json? // string[] short feature tags shown on the card

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]
  reviews    Review[]
  wishlist   WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([supplierId, supplierItemId])
  @@index([categoryId, status, price])
  @@index([status, country])
  @@index([status, createdAt])
  @@index([sourceType, status])
  @@index([sellerId])
}

// ─── Sync configuration & runs ─────────────────────────────────────────────
model SyncRule {
  id               String   @id @default(cuid())
  name             String
  enabled          Boolean  @default(true)
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  supplierCategory String // supplier-side category slug (e.g. "steam")
  // Filters (all optional). Stored explicitly for admin editing.
  minSellerRating  Float?
  maxSupplierPrice Float?
  minSupplierPrice Float?
  country          String?
  platform         String?
  deliveryType     String? // auto | manual
  autoDeliveryOnly Boolean  @default(true)
  keywords         Json? // string[]
  whitelist        Json? // string[]
  blacklist        Json? // string[]
  maxImport        Int      @default(50)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SyncRun {
  id         String    @id @default(cuid())
  supplierId String
  supplier   Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  status     String    @default("running") // running | success | failed
  imported   Int       @default(0)
  updated    Int       @default(0)
  removed    Int       @default(0)
  message    String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}

// ─── Pricing engine ────────────────────────────────────────────────────────
model PricingRule {
  id         String    @id @default(cuid())
  name       String
  // Global rule when categoryId is null; category rules override the global one.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  type       String    @default("percent") // percent | flat
  value      Float     @default(25) // 25 => +25% or +$25 depending on type
  minMargin  Float? // never sell below cost + minMargin
  maxMargin  Float? // cap the added margin
  rounding   String    @default("none") // none | up_99 (….99) | up_int
  enabled    Boolean   @default(true)
  priority   Int       @default(0) // higher wins among category rules
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ─── Orders & delivery ─────────────────────────────────────────────────────
model Order {
  id            String   @id @default(cuid())
  reference     String   @unique
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  status        String   @default("pending") // pending | paid | delivering | completed | failed | cancelled | refunded
  paymentMethod String   @default("wallet") // wallet | stripe | crypto
  currency      String   @default("USD")
  total         Float    @default(0)
  cost          Float    @default(0)
  profit        Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items      OrderItem[]
  credential Credential[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  title     String
  price     Float
  cost      Float
  qty       Int     @default(1)
}

// Encrypted delivered credentials (AES-256-GCM). Never store secrets in plaintext.
model Credential {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productTitle   String
  supplierItemId String?
  ciphertext     String // base64 iv:tag:data
  createdAt      DateTime @default(now())
}

// ─── Community & engagement (real data only) ───────────────────────────────
model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int // 1..5
  comment   String?
  status    String   @default("published") // pending | published | hidden
  helpful   Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique
  type       String    @default("percent") // percent | flat
  value      Float
  maxUses    Int?
  uses       Int       @default(0)
  expiresAt  DateTime?
  enabled    Boolean   @default(true)
  createdAt  DateTime  @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())
}

// Key/value site settings (currency, brand text, feature flags…).
model Setting {
  key   String @id
  value String
}

// ─── Seller marketplace ────────────────────────────────────────────────────
model SellerApplication {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  bio         String?
  experience  String?
  categories  String?  // comma-separated
  country     String?
  portfolio   String?
  discord     String?
  telegram    String?
  website     String?
  reason      String?
  status      String   @default("pending") // pending | approved | rejected
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
}

model SellerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug        String   @unique
  displayName String
  bio         String?
  badge       String   @default("seller") // seller | verified | pro
  level       Int      @default(1)
  reputation  Int      @default(0)
  verified    Boolean  @default(false)
  status      String   @default("active") // active | suspended
  ratingAvg   Float    @default(0)
  ratingCount Int      @default(0)
  salesCount  Int      @default(0)
  earnings    Float    @default(0)
  followerCount Int    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
  payouts  SellerPayout[]
}

model SellerPayout {
  id        String        @id @default(cuid())
  sellerId  String
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  amount    Float
  method    String        @default("manual") // manual | crypto | bank
  status    String        @default("pending") // pending | paid | cancelled
  note      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([sellerId, status])
}

// ─── Promo / discount codes ────────────────────────────────────────────────
model PromoCode {
  id        String   @id @default(cuid())
  code      String   @unique // stored uppercase
  type      String   @default("percent") // percent | flat
  value     Float // 10 => 10% off (percent) or $10 off (flat)
  maxUses   Int? // total redemptions allowed (null = unlimited)
  uses      Int      @default(0)
  perUser   Int      @default(1) // redemptions allowed per user
  minOrder  Float? // minimum order total to qualify
  maxDiscount Float? // cap the discount amount (for percent codes)
  expiresAt DateTime?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions PromoRedemption[]
}

model PromoRedemption {
  id        String    @id @default(cuid())
  codeId    String
  promo     PromoCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  userId    String
  orderRef  String?
  discount  Float // discount amount applied
  createdAt DateTime  @default(now())

  @@index([codeId, userId])
}

// ─── Community forum ───────────────────────────────────────────────────────
model ForumCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  topicCount  Int      @default(0)
  createdAt   DateTime @default(now())

  topics ForumTopic[]
}

model ForumTopic {
  id         String   @id @default(cuid())
  categoryId String
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title      String
  slug       String   @unique
  body       String
  kind       String   @default("discussion") // discussion | guide | question | service | marketplace
  pinned     Boolean  @default(false)
  locked     Boolean  @default(false)
  views      Int      @default(0)
  replyCount Int      @default(0)
  lastReplyAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  posts ForumPost[]

  @@index([categoryId, lastReplyAt])
  @@index([createdAt])
}

model ForumPost {
  id        String   @id @default(cuid())
  topicId   String
  topic     ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reactions ForumReaction[]

  @@index([topicId, createdAt])
}

model ForumReaction {
  id        String   @id @default(cuid())
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String   // like | fire | helpful | wow
  createdAt DateTime @default(now())

  @@unique([postId, userId, emoji])
}

// ─── Social graph ──────────────────────────────────────────────────────────
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

// ─── Messaging ─────────────────────────────────────────────────────────────
model Conversation {
  id        String   @id @default(cuid())
  kind      String   @default("dm") // dm | order
  orderRef  String?
  subject   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  typingAt       DateTime?
  joinedAt       DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  attachmentUrl  String?
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
}

// ─── Marketplace activity feed ─────────────────────────────────────────────
model ActivityEvent {
  id        String   @id @default(cuid())
  type      String   // product_added | product_sold | seller_joined | review | forum_topic | announcement | flash_sale | user_joined
  title     String
  body      String?
  href      String?
  meta      String?  // JSON blob
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
}
