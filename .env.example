# ─── Database (Neon Postgres — direct) ──────────────────────────────────────
# Direct Neon URL used by the app (Neon serverless driver) and Prisma CLI.
DATABASE_URL="postgresql://user:password@host:5432/rumart?sslmode=require"

# ─── Auth (Auth.js v5) — generate: npx auth secret ──────────────────────────
AUTH_SECRET="change-me"
AUTH_TRUST_HOST="true"
AUTH_URL="https://rumart.amex26292265.workers.dev"
ADMIN_EMAIL="admin@rumart.xyz"
ADMIN_PASSWORD="change-me"

# ─── Secrets encryption (AES-256-GCM), 64 hex chars ─────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_ENCRYPTION_KEY="change-me-64-hex-characters"

# ─── LZT Market supplier ────────────────────────────────────────────────────
LZT_API_BASE="https://prod-api.lolz.live"
LZT_API_TOKEN=""

# ─── Optional: Redis for BullMQ workers (blank = inline sync) ───────────────
REDIS_URL=""

# ─── Site ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://rumart.amex26292265.workers.dev"
SITE_CURRENCY="USD"

# ─── NOWPayments crypto payments ────────────────────────────────────────────
# IPN callback: https://rumart.amex26292265.workers.dev/api/webhooks/nowpayments
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
NOWPAYMENTS_PUBLIC_KEY=""

# ─── RedotPay Connect (stablecoin / crypto) ─────────────────────────────────
# Webhook: https://rumart.amex26292265.workers.dev/api/webhooks/redotpay
# App key from RedotPay merchant portal. Private key = your RSA PKCS8 PEM
# (upload the matching public key to RedotPay). Sandbox skips their sig check.
REDOTPAY_APP_KEY=""
REDOTPAY_PRIVATE_KEY=""
REDOTPAY_KEY_VERSION="1"
REDOTPAY_ENV="sandbox"

# ─── Cron ───────────────────────────────────────────────────────────────────
CRON_SECRET=""
