# ─── Database (Neon Postgres via Prisma Accelerate) ─────────────────────────
# DATABASE_URL: Prisma Accelerate connection string (console.prisma.io) — the
# app queries the DB over HTTPS through Accelerate everywhere (dev + Workers).
# DIRECT_DATABASE_URL: the underlying Neon Postgres URL — used only by the
# Prisma CLI (db push / migrate / studio / seed).
DATABASE_URL="prisma://accelerate.prisma.io/?api_key=YOUR_ACCELERATE_API_KEY"
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/rumart?sslmode=require"

# ─── Auth (Auth.js v5) — generate: npx auth secret ──────────────────────────
AUTH_SECRET="change-me"
AUTH_TRUST_HOST="true"
ADMIN_EMAIL="admin@rumart.xyz"
ADMIN_PASSWORD="change-me"

# ─── Secrets encryption (AES-256-GCM), 64 hex chars ─────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_ENCRYPTION_KEY="change-me-64-hex-characters"

# ─── LZT Market supplier ────────────────────────────────────────────────────
LZT_API_BASE="https://prod-api.lolz.live"
LZT_API_TOKEN=""

# ─── Optional: Redis for BullMQ workers (blank = inline sync) ───────────────
REDIS_URL=""

# ─── Site ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://rumart.xyz"
SITE_CURRENCY="USD"

# ─── Cryptomus crypto payments (get from cryptomus.com → Settings → API) ────
# Blank = crypto top-up disabled. Set the webhook URL in Cryptomus to
# https://<your-domain>/api/webhooks/cryptomus
CRYPTOMUS_MERCHANT_ID=""
CRYPTOMUS_PAYMENT_KEY=""
