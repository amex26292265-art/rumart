# ─── Application ────────────────────────────────────────────────────────────
APP_NAME="Memecoin Intelligence"
APP_ENV="local"
LOG_LEVEL="INFO"
API_HOST="0.0.0.0"
API_PORT="8000"
CORS_ORIGINS="http://localhost:3001,http://127.0.0.1:3001"
FRONTEND_ORIGIN="http://localhost:3001"

# ─── Database / Redis ───────────────────────────────────────────────────────
DATABASE_URL="postgresql+asyncpg://memecoin:memecoin@localhost:5432/memecoin_intelligence"
DATABASE_URL_SYNC="postgresql://memecoin:memecoin@localhost:5432/memecoin_intelligence"
REDIS_URL="redis://localhost:6379/0"

# ─── Trading mode (NEVER enable live without separate execution module) ─────
TRADING_MODE="paper"
PAPER_STARTING_BALANCE_USD="40"
PAPER_MAX_POSITION_USD="5"
PAPER_MAX_OPEN_POSITIONS="5"
LIVE_EXECUTION_ENABLED="false"

# ─── Staleness thresholds (seconds) ─────────────────────────────────────────
STALE_PRICE_SECONDS="30"
STALE_HOLDERS_SECONDS="120"
STALE_SOCIAL_SECONDS="180"
STALE_NEWS_SECONDS="900"

# ─── Solana / market providers (leave blank to keep provider disabled) ──────
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
HELIUS_API_KEY=""
HELIUS_RPC_URL=""
JUPITER_API_KEY=""
BIRDEYE_API_KEY=""
DEXSCREENER_BASE_URL="https://api.dexscreener.com"
PUMPPORTAL_WS_URL="wss://pumpportal.fun/api/data"

# ─── Social / news (official APIs only) ─────────────────────────────────────
X_BEARER_TOKEN=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="memecoin-intelligence/0.1 by local-dev"
CRYPTOPANIC_AUTH_TOKEN=""
GDELT_ENABLED="true"

# ─── LLM (explanation only; never invents numbers) ──────────────────────────
LLM_PROVIDER="none"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
LLM_MODEL=""

# ─── Alerts (Phase 10) ──────────────────────────────────────────────────────
ENABLE_DESKTOP_NOTIFICATIONS="true"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
DISCORD_WEBHOOK_URL=""
ALERT_EMAIL_SMTP_URL=""

# ─── Axiom UX helpers (no unofficial API) ───────────────────────────────────
# Official docs do not document a mint deep-link. Pulse is documented.
AXIOM_PULSE_URL="https://axiom.trade/pulse"
AXIOM_MINT_DEEP_LINK_TEMPLATE=""

# ─── Frontend ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
NEXT_PUBLIC_WS_URL="ws://localhost:8000/ws"
