# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# memecoin-intelligence local artifacts
memecoin-intelligence/**/node_modules/
memecoin-intelligence/**/.venv/
memecoin-intelligence/**/.next/
memecoin-intelligence/.env
memecoin-intelligence/backend/.pytest_cache/

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep the template, never commit real secrets
.env*
!.env.example

# local sqlite (no longer used; Postgres for dev + prod)
prisma/dev.db
*.db

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# single app — no pnpm workspace file (breaks Cloudflare pnpm)
pnpm-workspace.yaml
.open-next
.wrangler
.dev.vars
