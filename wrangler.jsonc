{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rumart",
  "main": ".open-next/worker.js",
  // nodejs_compat lets Prisma's Neon adapter, Node crypto (AES-GCM) and
  // bcryptjs run on Workers. Date must be >= 2024-09-23 for nodejs_compat.
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  // keep_vars false so stale dashboard plain vars (e.g. AUTH_URL) cannot
  // survive deploys and break custom domains. All plain vars live in `vars`
  // below; encrypted Secrets always survive either way.
  "keep_vars": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Cron paused while Neon data-transfer quota recovers (re-enable */30 after quota resets).
  "triggers": {
    "crons": []
  },
  // Non-secret runtime config, committed so `wrangler deploy` never wipes it.
  // SECRETS (DATABASE_URL, AUTH_SECRET, SECRETS_ENCRYPTION_KEY, LZT_API_TOKEN,
  // NOWPAYMENTS_*, ADMIN_*, CRON_SECRET) must be set as encrypted Secrets.
  // Do NOT set AUTH_URL here — it hardcodes absolute auth URLs and breaks
  // custom domains (sign-in/callback bounce to workers.dev). AUTH_TRUST_HOST
  // + trustHost in auth.ts use the request Host instead.
  // SITE_PUBLIC=false keeps rumart.wtf / workers.dev on the coming-soon gate
  // until launch. Unlock with ?preview=<SITE_PREVIEW_SECRET> (secret).
  // Note: privacy gate runs in Edge middleware (src/middleware.ts) — OpenNext
  // Cloudflare does not support Node.js proxy.ts.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://rumart.wtf",
    "AUTH_TRUST_HOST": "true",
    "SITE_PUBLIC": "true",
    "SITE_CURRENCY": "USD",
    "LZT_API_BASE": "https://prod-api.lolz.live"
  }
}
