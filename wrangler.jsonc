{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rumart",
  "main": ".open-next/worker.js",
  // nodejs_compat lets Prisma's Neon adapter, Node crypto (AES-GCM) and
  // bcryptjs run on Workers. Date must be >= 2024-09-23 for nodejs_compat.
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
